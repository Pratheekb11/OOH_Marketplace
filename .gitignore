# GitHub — local-only helpers stay ignored, but workflows must be committed
# or Actions never sees them. (A `.github/` directory exclusion cannot be
# undone by a later negation, because git does not descend into an excluded
# directory; excluding the contents instead is what makes the re-include work.)
.github/*
!.github/workflows/

# Architecture and documentation
Ui_Prototype_MVP_Prep/arch/
AdSpace_Marketplace_PRD*

# Lock files
.~lock*

# Node modules and dependencies
node_modules/
npm-debug.log
yarn-error.log

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
